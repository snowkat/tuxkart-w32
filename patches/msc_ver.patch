+  // Sorry, no stereo for MinGW :(
+#ifndef __MINGW32__
+
   static int firsttime = TRUE ;
 
   if ( firsttime )
@@ -171,6 +174,8 @@
     outb ( (stereo==-1) ? ~3 : ~2, LPBASE+2 ) ;
     stereo = -stereo ;
   }
+
+#endif
 }
 
 
