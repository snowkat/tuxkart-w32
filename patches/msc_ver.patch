Some _MSC_VER guards were a bit too restrictive, as MinGW also needs to use
those Win32 API calls.

--- ./tuxkart-0.4.0/src/tuxkart.cxx.orig	2025-03-17 18:33:15.902486584 -0700
+++ ./tuxkart-0.4.0/src/tuxkart.cxx	2025-03-17 18:44:18.512855863 -0700
@@ -461,7 +461,7 @@
     {
       char buffer [ 20 ] ;
 
-#ifdef _MSC_VER
+#if defined(_MSC_VER) || defined(__MINGW32__)
       Sleep ( 1000 ) ;
 #else
 	  sleep ( 1 ) ;
@@ -483,14 +483,14 @@
     if ( getenv ( "TUXKART_DATADIR" ) != NULL )
       datadir = getenv ( "TUXKART_DATADIR" ) ;
     else
-#ifdef _MSC_VER
+#if defined(_MSC_VER) || defined(__MINGW32__)
     if ( _access ( "data/levels.dat", 04 ) == 0 )
 #else
     if ( access ( "data/levels.dat", F_OK ) == 0 )
 #endif
       datadir = "." ;
     else
-#ifdef _MSC_VER
+#if defined(_MSC_VER) || defined(__MINGW32__)
     if ( _access ( "../data/levels.dat", 04 ) == 0 )
 #else
     if ( access ( "../data/levels.dat", F_OK ) == 0 )
@@ -507,7 +507,7 @@
   fprintf ( stderr, "Data files will be fetched from: '%s'\n",
                                                     datadir ) ;
 
-#ifdef _MSC_VER
+#if defined(_MSC_VER) || defined(__MINGW32__)
   if ( _chdir ( datadir ) == -1 )
 #else
   if ( chdir ( datadir ) == -1 )
